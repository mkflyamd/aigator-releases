# IDE / tool configs
# Ignore .claude/ but track the upper-fixer skill (our own, versioned)
# Aider cache (regenerated on every run, cannot be relocated)
.aider.*
# OpenCode config - regenerated per-run by run-opencode.ps1, contains gateway URL
opencode.json
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/upper-fixer/
.cline/
.cursor/

# Git worktrees
.worktrees/

# upper-fixer session state (local only)
.gator-session.json

# Python
__pycache__/
*.py[cod]
*.pyo
.venv
.venv/
.venv-*/
venv/
env/

# Secrets
.env
.env.*
credentials.json
token.json
*_token.json

# OS
.DS_Store
Thumbs.db

# Build artifacts — binaries, installers, embedded Python, logs, certs
build/AIGator.exe
build/AIGator_CodeSign.cer
build/AIGator_CodeSign.pfx
build/dist/
build/python_dist/
build/python-*.zip
build/build_err.txt
build/build_out.txt
build/aigator_tray.onefile-build/

# Bundled portable Node.js runtime (downloaded by build.bat / WakeGator.*) —
# never commit the ~80MB binaries; they're fetched fresh at build/setup time.
/node/
build/node_dist/
build/node_tmp/
build/node-v*.zip

# Bundled portable Electron runtime (downloaded by WakeGator.* / build.bat) —
# never commit the ~225MB binaries; fetched fresh at setup/build time.
/electron/
build/electron_dist/
build/electron_tmp/
build/electron-v*.zip

# Superpowers internal brainstorm sessions
.superpowers/

# Supergoal run artifacts (local planning state)
.supergoal/

# Sensitive internal docs (keep in private repo only)
token_troubleshooting.md
docs/internal/

# Dev scratch files
web/static/gator-preview.html
this_is_fun.txt
=*

# Random binary/output files
*.pptx

# Dev server logs (Option A — see dev.ps1)
logs/

# Test + build caches (regenerated on every run)
.pytest_cache/
tests/_test_turn_telemetry.db
build/pyinstaller_work/
build/pyinstaller-desktop/
/dist/

# Scratch/build exhaust — Gator working dirs and deck builds live in ~/.gator/work
deckbuild/
.aider*
!.aiderignore
.playwright-mcp/
